{
  "stryker-config": {
    "project": "Fairness.Domain.csproj",
    "test-projects": [
      "tests/backend/Modules/Fairness.Tests/Fairness.Tests.csproj"
    ],
    "mutate": [
      "**/src/backend/Modules/Fairness/Fairness.Domain/**/*.cs",
      "!**/obj/**"
    ],
    "coverage-analysis": "off",
    "concurrency": 1,
    "test-case-filter": "FullyQualifiedName~Apogeu.Fairness.Tests.&Category!=Nightly&Category!=Performance&Category!=Integration",
    "reporters": [
      "progress",
      "cleartext",
      "html",
      "json"
    ],
    "thresholds": {
      "high": 95,
      "low": 90,
      "break": 85
    }
  }
}
