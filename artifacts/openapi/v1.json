{
  "openapi": "3.1.1",
  "info": {
    "title": "Apogeu.Host | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/meta": {
      "get": {
        "tags": [
          "Meta"
        ],
        "operationId": "GetMeta",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me/bets": {
      "get": {
        "tags": [
          "Betting"
        ],
        "summary": "The bets of the session player, most recent first, paged by an opaque cursor.",
        "operationId": "GetMyBets",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "before",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MyBetsPage"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/operator/launch": {
      "post": {
        "tags": [
          "Operator"
        ],
        "summary": "Issues a single-use launch URL for a player (demo mode only).",
        "operationId": "LaunchGame",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LaunchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LaunchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions": {
      "post": {
        "tags": [
          "Sessions"
        ],
        "summary": "Exchanges a launch token for a player session.",
        "operationId": "CreateSession",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/backoffice/me": {
      "get": {
        "tags": [
          "Backoffice"
        ],
        "summary": "The authenticated backoffice user: id, Apogeu roles and operator.",
        "operationId": "GetBackofficeMe",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/api/v1/games": {
      "get": {
        "tags": [
          "Operator"
        ],
        "summary": "The games enabled for the calling operator, with their currencies and the art of their visual kit.",
        "operationId": "ListGames",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GameSummaryResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/salas/{salaId}/rounds": {
      "get": {
        "tags": [
          "Rounds"
        ],
        "operationId": "GetSalaRounds",
        "parameters": [
          {
            "name": "salaId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RoundHistoryItem"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/rounds/{roundId}/verification": {
      "get": {
        "tags": [
          "Rounds"
        ],
        "operationId": "GetRoundVerification",
        "parameters": [
          {
            "name": "roundId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoundVerificationResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/wallet/balance": {
      "get": {
        "tags": [
          "Wallet"
        ],
        "summary": "The balance of the session player in the session currency.",
        "operationId": "GetWalletBalance",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BalanceResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/wallet/demo/recharge": {
      "post": {
        "tags": [
          "Wallet"
        ],
        "summary": "Recharges the demo balance of the session player back to the opening amount when it is below the minimum bet.",
        "operationId": "RechargeDemoWallet",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RechargeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BalanceResponse": {
        "required": [
          "balance",
          "currency",
          "mode"
        ],
        "type": "object",
        "properties": {
          "balance": {
            "$ref": "#/components/schemas/Money"
          },
          "currency": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          }
        }
      },
      "CreateSessionRequest": {
        "required": [
          "launchToken"
        ],
        "type": "object",
        "properties": {
          "launchToken": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ErrorResponse": {
        "required": [
          "title",
          "status",
          "code"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "code": {
            "type": "string"
          },
          "errors": {
            "type": [
              "null",
              "object"
            ],
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "GameSummaryResponse": {
        "required": [
          "code",
          "name",
          "currencies",
          "thumbnailUrl",
          "bannerUrl"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "currencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "thumbnailUrl": {
            "type": "string"
          },
          "bannerUrl": {
            "type": "string"
          }
        }
      },
      "LaunchRequest": {
        "required": [
          "playerId",
          "nickname",
          "currency",
          "gameCode",
          "mode",
          "language"
        ],
        "type": "object",
        "properties": {
          "playerId": {
            "type": [
              "null",
              "string"
            ]
          },
          "nickname": {
            "type": [
              "null",
              "string"
            ]
          },
          "currency": {
            "type": [
              "null",
              "string"
            ]
          },
          "gameCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "mode": {
            "type": [
              "null",
              "string"
            ]
          },
          "language": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "LaunchResponse": {
        "required": [
          "launchUrl",
          "expiresAt"
        ],
        "type": "object",
        "properties": {
          "launchUrl": {
            "type": "string",
            "format": "uri"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MeResponse": {
        "required": [
          "userId",
          "roles",
          "operatorId"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "operatorId": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "MetaResponse": {
        "required": [
          "apiVersion",
          "serverTime"
        ],
        "type": "object",
        "properties": {
          "apiVersion": {
            "type": "string"
          },
          "serverTime": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Money": {
        "pattern": "^-?\\d+\\.\\d{2,}$",
        "type": "string",
        "format": "money"
      },
      "Multiplier": {
        "pattern": "^-?\\d+\\.\\d{2,}$",
        "type": "string",
        "format": "multiplier"
      },
      "MyBetItem": {
        "required": [
          "betId",
          "roundId",
          "roundNumber",
          "panel",
          "amount",
          "currency",
          "autoCashOut",
          "multiplier",
          "payout",
          "status",
          "placedAt"
        ],
        "type": "object",
        "properties": {
          "betId": {
            "type": "string",
            "format": "uuid"
          },
          "roundId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "roundNumber": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int64"
          },
          "panel": {
            "type": "integer",
            "format": "int32"
          },
          "amount": {
            "$ref": "#/components/schemas/Money"
          },
          "currency": {
            "type": "string"
          },
          "autoCashOut": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Multiplier"
              }
            ]
          },
          "multiplier": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Multiplier"
              }
            ]
          },
          "payout": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Money"
              }
            ]
          },
          "status": {
            "$ref": "#/components/schemas/MyBetStatus"
          },
          "placedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MyBetsPage": {
        "required": [
          "items",
          "nextCursor"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MyBetItem"
            }
          },
          "nextCursor": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "MyBetStatus": {
        "enum": [
          "placed",
          "queued",
          "active",
          "cashed_out",
          "lost",
          "cancelled",
          "refunded"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RechargeResponse": {
        "required": [
          "balance",
          "currency"
        ],
        "type": "object",
        "properties": {
          "balance": {
            "$ref": "#/components/schemas/Money"
          },
          "currency": {
            "type": "string"
          }
        }
      },
      "RoundHistoryItem": {
        "required": [
          "roundId",
          "roundNumber",
          "crashPoint",
          "crashedAt"
        ],
        "type": "object",
        "properties": {
          "roundId": {
            "type": "string",
            "format": "uuid"
          },
          "roundNumber": {
            "type": "integer",
            "format": "int64"
          },
          "crashPoint": {
            "$ref": "#/components/schemas/Multiplier"
          },
          "crashedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RoundVerificationResponse": {
        "required": [
          "seed",
          "previousSeed",
          "salt",
          "rtp",
          "cap",
          "crashPoint",
          "terminalHash"
        ],
        "type": "object",
        "properties": {
          "seed": {
            "type": "string"
          },
          "previousSeed": {
            "type": "string"
          },
          "salt": {
            "type": "string"
          },
          "rtp": {
            "type": "string"
          },
          "cap": {
            "$ref": "#/components/schemas/Multiplier"
          },
          "crashPoint": {
            "$ref": "#/components/schemas/Multiplier"
          },
          "terminalHash": {
            "type": "string"
          }
        }
      },
      "SessionPlayer": {
        "required": [
          "nickname"
        ],
        "type": "object",
        "properties": {
          "nickname": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SessionResponse": {
        "required": [
          "sessionToken",
          "expiresAt",
          "player",
          "salaId",
          "currency",
          "mode"
        ],
        "type": "object",
        "properties": {
          "sessionToken": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "player": {
            "$ref": "#/components/schemas/SessionPlayer"
          },
          "salaId": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Meta"
    },
    {
      "name": "Betting"
    },
    {
      "name": "Operator"
    },
    {
      "name": "Sessions"
    },
    {
      "name": "Backoffice"
    },
    {
      "name": "Rounds"
    },
    {
      "name": "Wallet"
    }
  ]
}
