<Project Sdk="Microsoft.NET.Sdk">

  <!-- SPEC-0004: tests of the GitHub Actions pipeline. Static checks run in the normal suite; the live tests
       (Category=CiLive) open real pull requests and only run with APOGEU_CI_LIVE=1 (see tests/ci/README.md). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.extensibility.core" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <!-- Process helpers shared with the repository tests (SPEC-0002), linked to keep one implementation. -->
  <ItemGroup>
    <Compile Include="../../backend/Repository.Tests/Support/ProcessRunner.cs" Link="Support/Shared/ProcessRunner.cs" />
    <Compile Include="../../backend/Repository.Tests/Support/ProcessResult.cs" Link="Support/Shared/ProcessResult.cs" />
    <Compile Include="../../backend/Repository.Tests/Support/RepositoryRoot.cs" Link="Support/Shared/RepositoryRoot.cs" />
  </ItemGroup>

</Project>
