<Project Sdk="Microsoft.NET.Sdk">

  <!-- ADR-0016 exception (SPEC-0004 emenda): the Aspire SDK adds Aspire.Dashboard.Sdk.<rid> and
       Aspire.Hosting.Orchestration.<rid> for the machine's own platform, so no single packages.lock.json fits macOS and
       the Linux CI runners. This project (and the tests that reference the AppHost) restore without a lock file. -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- The projects under Fixtures/ are compiled on their own: they hold the known violations (SPEC-0003 §7). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Fixtures/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.extensibility.core" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="TngTech.ArchUnitNET" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real assemblies checked by IT-01: the Host references every module and BuildingBlocks. -->
    <ProjectReference Include="../../../src/backend/Host/Host.csproj" />
    <!-- Aliased: AppHost and Host both expose a top-level Program class; referenced so the solution-wide rules see Apogeu.AppHost. -->
    <ProjectReference Include="../../../src/backend/AppHost/AppHost.csproj" Aliases="AppHostAssembly" />
    <!-- Fixture assemblies with known violations, used by UT-01..UT-04. -->
    <ProjectReference Include="Fixtures/Architecture.Fixtures/Architecture.Fixtures.csproj" />
    <ProjectReference Include="Fixtures/StandIn.MediatR/StandIn.MediatR.csproj" />
    <ProjectReference Include="Fixtures/StandIn.AutoMapper/StandIn.AutoMapper.csproj" />
  </ItemGroup>

</Project>
