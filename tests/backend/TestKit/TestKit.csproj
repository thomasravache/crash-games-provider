<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared test infrastructure (SPEC-0003, ADR-0009): Testcontainers fixtures and determinism helpers. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- The TestKit's own tests live in Tests/ and are a separate project. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.extensibility.core" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.Redis" />
    <PackageReference Include="Testcontainers.Keycloak" />
  </ItemGroup>

</Project>
