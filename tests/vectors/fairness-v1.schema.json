{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Apogeu provably-fair vectors v1 (SPEC-0007)",
  "description": "Fixed vectors of the provably-fair algorithm v1 (SPEC-0007 §4, ADR-0006), shared by the C# Fairness module and the TypeScript verifier.",
  "type": "object",
  "required": ["version", "algorithm", "vectors"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "$comment": { "type": "string" },
    "version": { "const": 1 },
    "algorithm": {
      "type": "object",
      "required": ["chain", "hmac", "sample", "crashPoint", "encoding"],
      "additionalProperties": false,
      "properties": {
        "chain": { "type": "string", "minLength": 1 },
        "hmac": { "type": "string", "minLength": 1 },
        "sample": { "type": "string", "minLength": 1 },
        "crashPoint": { "type": "string", "minLength": 1 },
        "encoding": { "type": "string", "minLength": 1 }
      }
    },
    "vectors": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["seed", "previousSeed", "salt", "rtp", "cap", "crashPoint"],
        "additionalProperties": false,
        "properties": {
          "description": { "type": "string" },
          "seed": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "previousSeed": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "salt": { "type": "string", "pattern": "^([0-9a-f]{2})+$" },
          "rtp": { "type": "string", "pattern": "^0\\.9[0-9]$" },
          "cap": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]{2}$" },
          "crashPoint": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]{2}$" }
        }
      }
    }
  }
}
