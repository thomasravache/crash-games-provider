#!/usr/bin/env python3
"""Runs only the tests affected by the current change (SPEC-0051): the `test` and `coverage` gates of
docs/specs/sdd-config.yml. Stdlib only. CI and the G5 gates (test_integration, test_e2e, arch_test, security_scan)
still run the whole suite.

Usage: python3 tools/ci/affected-tests [--base REF] [--files F ...] [--list | --dry-run] [--mode test|coverage]

Changed files: --files when given; otherwise `git diff --name-only <base>...HEAD` plus staged, unstaged and untracked
files of the git repository of the current directory. Base: --base, else a non-empty AFFECTED_BASE, else
sdd/SPEC-0001 (main when that branch does not exist).

Mapping (in doubt, the whole solution; when the solution is selected, it is the only target):
  src/backend/Modules/<X>/<X>.Contracts/**            -> solution
  src/backend/Modules/<X>/** (X with a test project)  -> tests/backend/Modules/<X>.Tests + Architecture.Tests
  src/backend/(BuildingBlocks|ServiceDefaults|Host|AppHost)/**, Directory.*.props, *.slnx, global.json,
  packages.lock.json, src/frontend/pnpm-lock.yaml, tests/backend/TestKit/**  -> solution
  src/frontend/**, tests/frontend/**, tests/e2e/**    -> frontend (pnpm -C src/frontend test)
  tests/backend/Modules/<P>/**, tests/backend/<P>/**  -> that test project
  tests/ci/**, tools/**, .github/**                   -> tests/ci/Ci.Tests
  docs/**, root *.md                                  -> nothing
  anything else, or no changed file at all            -> solution

--list prints the targets, --dry-run the commands; by default the commands run one after the other from the
repository root and the first failure stops the run with its exit code.

Performance pass: `dotnet test --filter Category=Performance` on a project without such tests exits with 0 under
this repository's runner (VSTest prints "No test matches the given testcase filter"), so the command runs as is.
"""
from __future__ import annotations

import argparse
import glob
import os
import re
import subprocess
import sys

SOLUTION = "solution"
FRONTEND = "frontend"
SOLUTION_FILE = "Apogeu.slnx"
ARCHITECTURE_TESTS = "tests/backend/Architecture.Tests/Architecture.Tests.csproj"
CI_TESTS = "tests/ci/Ci.Tests/Ci.Tests.csproj"
# Modules with a project in tests/backend/Modules; any other module (Backoffice) runs the whole solution.
MODULES_WITH_TESTS = {"Betting", "Fairness", "Operators", "Rounds", "Wallet"}
DEFAULT_BASE = "sdd/SPEC-0001"
FALLBACK_BASE = "main"

TEST_FILTER = '"Category!=Nightly&Category!=CiLive&Category!=Performance"'
COVERAGE_REPORTS = ["artifacts/coverage/raw/**/coverage.cobertura.xml", "src/frontend/coverage/lcov.info"]
REPORTGENERATOR = (
    'dotnet reportgenerator "-reports:{reports}" -targetdir:artifacts/coverage "-reporttypes:Cobertura;TextSummary;Html" '
    '"-assemblyfilters:-Apogeu.TestKit*;-Apogeu.Architecture.*;-Apogeu.Repository.*;-*.Tests;-*.StandIn"'
)

SOLUTION_PATTERNS = [
    re.compile(r"^src/backend/(BuildingBlocks|ServiceDefaults|Host|AppHost)/"),
    re.compile(r"^Directory\.[^/]*\.props$"),
    re.compile(r"^[^/]*\.slnx$"),
    re.compile(r"^global\.json$"),
    re.compile(r"(^|/)packages\.lock\.json$"),
    re.compile(r"^src/frontend/pnpm-lock\.yaml$"),
    re.compile(r"^tests/backend/TestKit/"),
]
MODULE = re.compile(r"^src/backend/Modules/([^/]+)/(?:([^/]+)/)?")
MODULE_TESTS = re.compile(r"^tests/backend/Modules/([^/]+)/")
BACKEND_TESTS = re.compile(r"^tests/backend/([^/]+)/")


def targets_for(path: str) -> set[str]:
    """The test targets of one changed file (repository-relative, forward slashes)."""
    if path.startswith("docs/") or ("/" not in path and path.endswith(".md")):
        return set()
    if any(pattern.search(path) for pattern in SOLUTION_PATTERNS):
        return {SOLUTION}
    if match := MODULE.match(path):
        module, project = match.group(1), match.group(2)
        if project == f"{module}.Contracts" or module not in MODULES_WITH_TESTS:
            return {SOLUTION}
        return {f"tests/backend/Modules/{module}.Tests/{module}.Tests.csproj", ARCHITECTURE_TESTS}
    if path.startswith(("src/frontend/", "tests/frontend/", "tests/e2e/")):
        return {FRONTEND}
    if match := MODULE_TESTS.match(path):
        project = match.group(1)
        return {f"tests/backend/Modules/{project}/{project}.csproj"}
    if match := BACKEND_TESTS.match(path):
        project = match.group(1)
        if project != "Modules":
            return {f"tests/backend/{project}/{project}.csproj"}
    if path.startswith(("tests/ci/", "tools/", ".github/")):
        return {CI_TESTS}
    return {SOLUTION}


def select(files: list[str]) -> list[str]:
    """The sorted targets of the changed files; the solution alone when it is selected or nothing changed."""
    if not files:
        return [SOLUTION]
    targets: set[str] = set()
    for file in files:
        targets |= targets_for(file.strip().replace("\\", "/").removeprefix("./"))
    return [SOLUTION] if SOLUTION in targets else sorted(targets)


def git(root: str, *arguments: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(["git", *arguments], cwd=root, capture_output=True, text=True, check=False)


def git_lines(root: str, *arguments: str) -> list[str]:
    result = git(root, *arguments)
    if result.returncode != 0:
        sys.exit(f"affected-tests: git {' '.join(arguments)} failed: {result.stderr.strip()}")
    return [line for line in result.stdout.splitlines() if line.strip()]


def resolve_base(root: str, requested: str | None) -> str:
    if requested:
        return requested
    if environment := os.environ.get("AFFECTED_BASE", "").strip():
        return environment
    exists = git(root, "rev-parse", "--verify", "--quiet", DEFAULT_BASE + "^{commit}").returncode == 0
    return DEFAULT_BASE if exists else FALLBACK_BASE


def changed_files(root: str, base: str) -> list[str]:
    files = set(git_lines(root, "diff", "--name-only", f"{base}...HEAD"))
    files |= set(git_lines(root, "diff", "--name-only", "--cached"))
    files |= set(git_lines(root, "diff", "--name-only"))
    files |= set(git_lines(root, "ls-files", "--others", "--exclude-standard"))
    return sorted(files)


def dotnet_target(target: str) -> str:
    return SOLUTION_FILE if target == SOLUTION else target


def commands_for(targets: list[str], mode: str) -> list[str]:
    commands: list[str] = []
    if mode == "coverage":
        if targets:
            commands.append("rm -rf artifacts/coverage src/frontend/coverage")
        for target in targets:
            if target == FRONTEND:
                commands.append("pnpm -C src/frontend test:coverage")
            else:
                commands.append(
                    f"dotnet test {dotnet_target(target)} --filter {TEST_FILTER} "
                    '--collect "XPlat Code Coverage" --results-directory artifacts/coverage/raw')
        return commands
    for target in targets:
        if target == FRONTEND:
            commands.append("pnpm -C src/frontend test")
        else:
            commands.append(f"dotnet test {dotnet_target(target)} --filter {TEST_FILTER}")
            commands.append(f"dotnet test {dotnet_target(target)} --filter Category=Performance -m:1")
    return commands


def run(command: str, root: str) -> int:
    print(f"$ {command}", file=sys.stderr, flush=True)
    return subprocess.run(command, shell=True, cwd=root, check=False).returncode


def report_coverage(root: str) -> int:
    """Merges the coverage reports that exist (ReportGenerator fails on a missing file)."""
    reports = [pattern for pattern in COVERAGE_REPORTS if glob.glob(os.path.join(root, pattern), recursive=True)]
    if not reports:
        print("affected-tests: no coverage report produced", file=sys.stderr)
        return 0
    for command in ("dotnet tool restore", REPORTGENERATOR.format(reports=";".join(reports))):
        if code := run(command, root):
            return code
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="Runs only the tests affected by the current change (SPEC-0051).")
    parser.add_argument("--base", help="git ref to diff against (default: AFFECTED_BASE, else sdd/SPEC-0001, else main)")
    parser.add_argument("--files", nargs="+", help="changed files to map instead of asking git")
    output = parser.add_mutually_exclusive_group()
    output.add_argument("--list", action="store_true", help="print the selected targets and exit")
    output.add_argument("--dry-run", action="store_true", help="print the commands and exit")
    parser.add_argument("--mode", choices=["test", "coverage"], default="test")
    arguments = parser.parse_args()

    root = git_lines(os.getcwd(), "rev-parse", "--show-toplevel")[0]
    files = arguments.files if arguments.files is not None else changed_files(root, resolve_base(root, arguments.base))
    targets = select(files)

    if arguments.list:
        print("\n".join(sorted(targets, key=lambda target: target.encode())))
        return 0

    commands = commands_for(targets, arguments.mode)
    if arguments.dry_run:
        print("\n".join(commands) if commands else "# nothing to test")
        return 0

    print("affected-tests: " + (", ".join(targets) if targets else "nothing to test"), file=sys.stderr)
    for command in commands:
        if code := run(command, root):
            return code
    if arguments.mode == "coverage" and targets:
        return report_coverage(root)
    return 0


if __name__ == "__main__":
    sys.exit(main())
