#!/usr/bin/env python3
"""Selects the Stryker targets that exist (SPEC-0004, nightly.yml). Stdlib only.

Usage: tools/ci/stryker-targets CONFIG OUTPUT_CONFIG

Reads CONFIG (stryker-config.json) and keeps only the test projects that exist. When none exists, mutation testing
has nothing to run: `ready=false` and no OUTPUT_CONFIG. Otherwise writes OUTPUT_CONFIG with the existing test
projects and only the `mutate` globs of their modules (a test project `<Module>.Tests` covers
`/Modules/<Module>/`; exclusion globs `!…` are kept), so code whose tests do not exist yet cannot break the threshold.
`ready=<true|false>` goes to $GITHUB_OUTPUT when set, otherwise to stdout.
"""
from __future__ import annotations

import json
import os
import sys
from pathlib import Path


def emit(ready: bool) -> None:
    line = f"ready={'true' if ready else 'false'}\n"
    output = os.environ.get("GITHUB_OUTPUT")
    if output:
        with open(output, "a", encoding="utf-8") as handle:
            handle.write(line)
    else:
        sys.stdout.write(line)


def main(argv: list[str]) -> int:
    if len(argv) != 3:
        print("usage: stryker-targets CONFIG OUTPUT_CONFIG", file=sys.stderr)
        return 2
    config = json.loads(Path(argv[1]).read_text(encoding="utf-8"))
    section = config["stryker-config"]
    projects = section.get("test-projects", [])
    existing = [project for project in projects if Path(project).is_file()]
    missing = [project for project in projects if project not in existing]
    for project in missing:
        print(f"stryker-targets: test project not found yet: {project}")

    if not existing:
        print("::notice::Mutation testing skipped: none of the test projects of stryker-config.json exists yet.")
        emit(False)
        return 0

    modules = [Path(project).stem.removesuffix(".Tests") for project in existing]
    mutate = [
        glob for glob in section.get("mutate", [])
        if glob.startswith("!") or any(f"/Modules/{module}/" in glob for module in modules)
    ]
    section = {**section, "test-projects": existing, "mutate": mutate}
    Path(argv[2]).write_text(json.dumps({"stryker-config": section}, indent=2) + "\n", encoding="utf-8")
    print(f"stryker-targets: mutating {', '.join(modules)} with {', '.join(existing)}")
    if missing:
        print(f"::notice::Mutation testing limited to {', '.join(modules)}; missing: {', '.join(missing)}")
    emit(True)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
