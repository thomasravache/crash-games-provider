<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- nuget.org is the only package source, so restores do not depend on a developer's user-level feeds (NU1507). -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
