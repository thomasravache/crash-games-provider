#!/bin/sh
# SDD pre-commit: valida specs/ADRs alterados no commit (rascunhos 'proposed' ficam de fora).
if git diff --cached --name-only | grep -Eq '^docs/(specs|adr)/'; then
  if ! python3 tools/sdd/spec_graph.py validate --staged; then
    echo "pre-commit: corrija os erros de validação SDD acima antes de commitar" >&2
    exit 1
  fi
fi

# Project step (not vendored): formatting of the staged files (ADR-0012).
hooks_dir=$(dirname "$0")
if [ -x "$hooks_dir/format-staged" ]; then
  "$hooks_dir/format-staged" || exit 1
fi
exit 0
