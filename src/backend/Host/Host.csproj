<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    OpenAPI document generated at build time (ADR-0008, SPEC-0006): Microsoft.Extensions.ApiDescription.Server runs the
    Host's document provider after the build and writes obj/openapi/v1.json; `pnpm contracts:generate` versions it in
    artifacts/openapi/v1.json and generates the TypeScript contracts from it.
  -->
  <PropertyGroup>
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/obj/openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name v1</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- In-process messaging and the transactional outbox on PostgreSQL (ADR-0002, SPEC-0022). -->
    <PackageReference Include="WolverineFx" />
    <PackageReference Include="WolverineFx.Postgresql" />
    <PackageReference Include="WolverineFx.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Modules/Rounds/Rounds.Features/Rounds.Features.csproj" />
    <ProjectReference Include="../Modules/Fairness/Fairness.Features/Fairness.Features.csproj" />
    <ProjectReference Include="../Modules/Betting/Betting.Features/Betting.Features.csproj" />
    <ProjectReference Include="../Modules/Wallet/Wallet.Features/Wallet.Features.csproj" />
    <ProjectReference Include="../Modules/Operators/Operators.Features/Operators.Features.csproj" />
    <ProjectReference Include="../Modules/Backoffice/Backoffice.Features/Backoffice.Features.csproj" />
    <ProjectReference Include="../BuildingBlocks/BuildingBlocks.csproj" />
    <ProjectReference Include="../ServiceDefaults/ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
